# Muse 注册机默认配置
# 复制为 .env 后修改即可

# ====== 注册 ======
# 默认邀请码 (6 位, 留空跳过兑换)
INVITE_CODE=

# 注册驱动：roxy 或 local
REGISTRATION_DRIVER=roxy

# ====== RoxyBrowser（只在本机 .env 填写） ======
ROXY_API_BASE=http://127.0.0.1:50100
ROXY_API_TOKEN=
ROXY_WORKSPACE_ID=
ROXY_PROJECT_ID=
ROXY_ONE_PROFILE_PER_ACCOUNT=true
ROXY_DELETE_PROFILE_AFTER_RUN=true

# ====== 代理池 (每行一个代理 URL) ======
# Muse 只对美国/加拿大开放, 出口必须在美加
# socks5h://user:pass@us-proxy-1:1080
# socks5h://user:pass@us-proxy-2:1080

# ====== 加密密钥 ======
# pycryptodome AES-GCM 32 bytes, base64 编码
# 未配置时首次运行自动生成
# CARD_ENCRYPTION_KEY=base64-encoded-32-bytes-key

# ====== OTP ======
OTP_MAX_WAIT=180
OTP_POLL_INTERVAL=5

# ====== 邮箱服务（可选，真实地址和凭证只放本机 .env） ======
EMAIL_SOURCE=outlook
OUTLOOK_API_BASE=
OUTLOOK_FETCH_MODE=auto
OMNIMAIL_BASE=
OMNIMAIL_EMAIL=
OMNIMAIL_PASSWORD=
